<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE suite SYSTEM
    "https://testng.org/testng-1.0.dtd">

<suite name="Sanity Suite">

    <parameter name="browser" value="chrome"/>
    <parameter name="os" value="windows"/>

    <listeners>
        <listener class-name="listeners.MyTestListener"/>
    </listeners>

    <test name="Sanity Tests">

        <groups>
            <run>
                <include name="sanity"/>
            </run>
        </groups>

        <classes>
            <class name="testCases.TC_HomePage"/>
            <class name="testCases.TC_Register"/>
            <class name="testCases.TC_Login"/>
            <class name="testCases.LoginDataDrivenTest"/>
        </classes>

    </test>

</suite>